# ─── OBLIGATORIO ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=TU_TOKEN_DE_BOTFATHER

# Tu Telegram user ID (obtenerlo con @userinfobot)
ADMIN_CHAT_IDS=123456789

# Canal donde el bot publicará (ej: @smacademia o el ID numérico -100...)
CHANNEL_ID=@smacademia_canal

# ─── IA (Gemini) ────────────────────────────────────────────────
GEMINI_API_KEY=TU_API_KEY_DE_GOOGLE_AI_STUDIO

# ─── OPCIONAL ───────────────────────────────────────────────────
